outputs/logs/*

# Keep directory placeholders
!data/uploads/.gitkeep
!data/images/.gitkeep
!data/vector_db/.gitkeep
!outputs/detected_images/.gitkeep
!outputs/generated_reports/.gitkeep
!outputs/logs/.gitkeep

