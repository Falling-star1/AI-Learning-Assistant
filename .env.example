# 复制本文件为 .env 并填入真实值（.env 不会被提交到仓库）
# 复制命令：Copy-Item .env.example .env

# ============================================================
# LLM Provider 选择
# ============================================================
# 可选值：auto / cloud / deepseek / qwen / ollama / fallback
# - auto      : 优先使用云端兼容 API，无 Key 时自动降级到 fallback
# - cloud     : 只用云端兼容 API（需配 LLM_API_KEY），失败时降级
# - deepseek  : 使用 DeepSeek 官方 API（需配 DEEPSEEK_API_KEY）
# - qwen      : 使用通义千问 DashScope（需配 DASHSCOPE_API_KEY）
# - ollama    : 使用本地 Ollama 模型（需先启动 Ollama 服务）
# - fallback  : 不调用任何大模型，仅返回本地检索片段，适合无网演示
LLM_PROVIDER=auto

# ============================================================
# 云端兼容 API（OpenAI 兼容接口）
# 适用于 auto / cloud 模式
# ============================================================
LLM_API_KEY=
LLM_MODEL_NAME=compatible-chat
LLM_BASE_URL=

# ============================================================
# DeepSeek 官方 API（deepseek 模式）
# 申请地址：https://platform.deepseek.com
# ============================================================
DEEPSEEK_API_KEY=

# ============================================================
# 通义千问 DashScope（qwen 模式）
# 申请地址：https://dashscope.console.aliyun.com
# ============================================================
DASHSCOPE_API_KEY=

# ============================================================
# 本地 Ollama（ollama 模式）
# 安装：https://ollama.com
# 拉模型：ollama pull qwen2.5:3b
# ============================================================
OLLAMA_MODEL_NAME=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
